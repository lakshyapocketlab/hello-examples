# Copy these into your shell (export ...) or a local .env you do NOT commit.
# The programs read the process environment; they do not load .env files themselves.

HELLO_API_KEY=hello_live_xxxxxxxx
# Numeric ID of the sending number (dashboard > Accounts, or GET /v1/phone_numbers).
HELLO_PHONE_NUMBER_ID=
# Recipient with country code, e.g. +919999999999. Free-form types need an open 24-hour window.
HELLO_TO=

# Public HTTPS URLs WhatsApp can download (image, video, audio, document, template media header).
HELLO_IMAGE_URL=
HELLO_VIDEO_URL=
HELLO_AUDIO_URL=
HELLO_DOCUMENT_URL=
# Stickers have no link option: upload a static WebP (up to 100 KB) and use the media id.
HELLO_STICKER_MEDIA_ID=

# reaction and reply: the wamid of a message the customer sent you (from an inbound webhook).
HELLO_REPLY_TO_MESSAGE_ID=

# Templates (must be APPROVED on the number's WABA). Language applies to all template types.
HELLO_TEMPLATE_LANGUAGE=en_US
# template: defaults to hello_world, which has no variables.
HELLO_TEMPLATE_NAME=hello_world
# Optional body variables, comma separated: positional "Asha,#10432" or named "first_name=Asha,otp=482913".
HELLO_TEMPLATE_PARAMS=
# template-header-footer, template-buttons, template-media: see README for each template's shape.
HELLO_TEMPLATE_HEADER_FOOTER_NAME=
HELLO_TEMPLATE_BUTTONS_NAME=
HELLO_TEMPLATE_MEDIA_NAME=

# Optional: override the API host.
# HELLO_BASE_URL=https://helloapi.lakshyapocketlab.com
