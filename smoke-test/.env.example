# Copy to .env (git-ignored) and fill in. Load it before running:
#   set -a; source .env; set +a
#
# Placeholders only. Never commit a real key or number.

# Required. A live key from the Hello dashboard (Integrations). Never print it.
HELLO_API_KEY=hello_live_xxx

# Required. Numeric phone_number_id of the sending number (GET /v1/phone_numbers).
HELLO_PHONE_NUMBER_ID=

# Required for --send. Recipient in E.164 digits, with country code and no spaces.
# Example format: 9198xxxxxxx (country code 91, then the number).
HELLO_TO=

# Optional. Template to send. Default: the first APPROVED template with no variables,
# else the first APPROVED one with body variables (filled with sample text).
HELLO_TEMPLATE_NAME=
# Optional. Language code of that template, e.g. en_US. Only needed when the name
# exists in several languages.
HELLO_TEMPLATE_LANGUAGE=

# Optional. Public https URLs. Defaults: a small PNG and a small PDF on public sites.
HELLO_MEDIA_IMAGE_URL=
HELLO_MEDIA_DOCUMENT_URL=
# Optional. No default. Video and audio steps are SKIPPED unless these are set.
HELLO_MEDIA_VIDEO_URL=
HELLO_MEDIA_AUDIO_URL=

# Optional. A wamid of an inbound message to mark as read (step 11). Unset = SKIP.
HELLO_INBOUND_MESSAGE_ID=

# Optional. Staging or a self-hosted gateway. Default: https://helloapi.lakshyapocketlab.com
HELLO_BASE_URL=
