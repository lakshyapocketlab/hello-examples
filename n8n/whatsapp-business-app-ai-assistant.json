{
  "name": "WhatsApp Business app assistant (Hello)",
  "nodes": [
    {
      "id": "hello-trigger",
      "name": "Hello Trigger",
      "type": "@lakshyapocketlab/n8n-nodes-hello.helloTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "phoneNumberId": "REPLACE_WITH_PHONE_NUMBER_ID",
        "events": [
          "message",
          "echo"
        ]
      },
      "webhookId": "b6c1d2e3-0000-4000-8000-000000000001",
      "credentials": {
        "helloApi": {
          "id": "REPLACE",
          "name": "Hello account"
        }
      }
    },
    {
      "id": "message-or-echo?",
      "name": "Message or echo?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "m",
                    "leftValue": "={{ $json.event }}",
                    "rightValue": "message",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "message"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "e",
                    "leftValue": "={{ $json.event }}",
                    "rightValue": "echo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "echo"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "assistant-allowed?",
      "name": "Assistant allowed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst paused = (data.humanUntil || {})[$json.from];\nreturn { json: { ...$json, assistantAllowed: !paused || paused < Date.now() } };"
      }
    },
    {
      "id": "text-and-not-paused?",
      "name": "Text and not paused?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "t",
              "leftValue": "={{ $json.type }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "a",
              "leftValue": "={{ $json.assistantAllowed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ai-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        940,
        80
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text.body }}",
        "options": {
          "systemMessage": "You are the assistant of Ana's Bakery. Answer questions about opening hours, prices and orders using only the information below. Keep replies under 60 words. If you do not know, say that a person will reply.\n\nOpening hours: REPLACE\nPrices: REPLACE\nOrders: REPLACE"
        }
      }
    },
    {
      "id": "openai-chat-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "simple-memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Hello Trigger').item.json.from }}"
      }
    },
    {
      "id": "send-reply",
      "name": "Send reply",
      "type": "@lakshyapocketlab/n8n-nodes-hello.hello",
      "typeVersion": 1,
      "position": [
        1300,
        80
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendText",
        "phoneNumberId": "={{ $('Hello Trigger').item.json.phone_number_id }}",
        "to": "=+{{ $('Hello Trigger').item.json.from }}",
        "text": "={{ $json.output }}",
        "options": {
          "idempotencyKey": "={{ $('Hello Trigger').item.json.message.id }}",
          "replyTo": "={{ $('Hello Trigger').item.json.message.id }}"
        }
      },
      "credentials": {
        "helloApi": {
          "id": "REPLACE",
          "name": "Hello account"
        }
      }
    },
    {
      "id": "person-replied",
      "name": "Person replied",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\ndata.humanUntil = data.humanUntil || {};\nfor (const item of $input.all()) {\n  // Pause the assistant for this customer for 2 hours.\n  data.humanUntil[item.json.to] = Date.now() + 2 * 60 * 60 * 1000;\n}\nreturn [];"
      }
    }
  ],
  "connections": {
    "Hello Trigger": {
      "main": [
        [
          {
            "node": "Message or echo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Message or echo?": {
      "main": [
        [
          {
            "node": "Assistant allowed?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Person replied",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assistant allowed?": {
      "main": [
        [
          {
            "node": "Text and not paused?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Text and not paused?": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Send reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}